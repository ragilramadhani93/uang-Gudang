{
  "expo": {
    "name": "OPS Gudang Tracker",
    "slug": "ops-gudang",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.opsgudang.tracker"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#18181B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.opsgudang.tracker",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikasi membutuhkan izin galeri untuk memilih foto struk.",
          "cameraPermission": "Aplikasi membutuhkan izin kamera untuk memfoto struk tol dan bensin."
        }
      ],
      "expo-font"
    ]
  }
}
